# dissertation-thesis-classes — keep the .cls/.tex/.bib + the example PDF;
# ignore only LaTeX build aux and OS/editor noise.

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.run.xml
*.bcf

# NOT ignored (intentional): *.cls, *.tex, *.bib, classes/**/example/sample-output.pdf

# OS / editor
.DS_Store
.Rhistory
.RData
*.swp

# house class (dataimago-thesis): build output of the example and test scratch
classes/dataimago-thesis/example/_build/
classes/dataimago-thesis/example/_book/
classes/dataimago-thesis/example/.quarto/
classes/dataimago-thesis/example/*.tex
classes/dataimago-thesis/example/*-luamml-mathml.html
classes/dataimago-thesis/example/*_files/
classes/dataimago-thesis/example/_quarto-t17.yml
classes/dataimago-thesis/example/_quarto-noto-math.yml
tests/smoke.pdf
tests/*.png
tests/dbg*.tex
tests/smoke-cu.tex
scratch-run.sh
__pycache__/
